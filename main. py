from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.textinput import TextInput

class CoopApp(App):
    def build(self):
        root = BoxLayout(orientation='vertical', padding=20, spacing=15)
        root.add_widget(Label(text='COOP Savings', font_size='28sp', size_hint_y=0.3))
        
        self.name_input = TextInput(hint_text='Member Name', size_hint_y=0.15, multiline=False)
        self.amount_input = TextInput(hint_text='Amount', input_filter='float', size_hint_y=0.15, multiline=False)
        
        btn = Button(text='Add Savings', size_hint_y=0.15, background_color=(0,0.6,0,1))
        btn.bind(on_press=self.add_savings)
        
        self.total_label = Label(text='Total: P0.00', font_size='20sp')
        
        root.add_widget(self.name_input)
        root.add_widget(self.amount_input)
        root.add_widget(btn)
        root.add_widget(self.total_label)
        
        self.total = 0
        return root

    def add_savings(self, instance):
        try:
            amt = float(self.amount_input.text or 0)
            self.total += amt
            self.total_label.text = f'Total: P{self.total:.2f}\nMember: {self.name_input.text}'
            self.amount_input.text = ''
        except:
            self.total_label.text = 'Enter valid amount'

CoopApp().run()
